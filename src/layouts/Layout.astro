---
import "../styles/global.css";
import { profile } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const canonicalUrl = Astro.props.canonical ?? "https://hanifabdillah.vercel.app/";
const siteTitle = Astro.props.title ?? `${profile.name} — ${profile.role} & Web Engineering Services`;
const siteDescription =
  Astro.props.description ??
  `Portfolio and professional web development services by ${profile.name} (${profile.role} at BSI UII). Building scalable, high-performance, and responsive web applications.`;
const ogImage = Astro.props.image ?? "https://hanifabdillah.vercel.app/og-image.png";

const keywords = [
  "Hanif Abdillah Kuswanto",
  "Frontend Developer",
  "Web Developer Yogyakarta",
  "Web Developer Magelang",
  "Software Engineer Portfolio",
  "Angular Developer",
  "TypeScript Developer",
  "Next.js Developer",
  "React Developer",
  "Vue Developer",
  "Jasa Pembuatan Website Yogyakarta",
  "Jasa Website Magelang",
  "Figma to Code Slicing",
  "Badan Sistem Informasi UII",
].join(", ");

const schemaJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://hanifabdillah.vercel.app/#person",
      "name": profile.name,
      "url": "https://hanifabdillah.vercel.app/",
      "image": ogImage,
      "jobTitle": profile.role,
      "description": profile.about,
      "email": profile.contact.email,
      "telephone": `+${profile.contact.whatsapp}`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Magelang",
        "addressRegion": "Central Java",
        "addressCountry": "ID",
      },
      "worksFor": {
        "@type": "Organization",
        "name": "Badan Sistem Informasi UII",
        "url": "https://bsi.uii.ac.id",
      },
      "knowsAbout": [
        ...profile.skills,
        "Frontend Development",
        "Web Development",
        "Single Page Application",
        "Responsive Web Design",
        "Figma Slicing",
        "Next.js",
      ],
      "sameAs": [
        "https://bsi.uii.ac.id",
        "https://github.com/Hnfzrog",
        "https://www.linkedin.com/in/hanif-abdillah-kuswanto",
      ],
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://hanifabdillah.vercel.app/#service",
      "name": `Web Engineering & Frontend Development Services — ${profile.name}`,
      "url": "https://hanifabdillah.vercel.app/",
      "image": ogImage,
      "telephone": `+${profile.contact.whatsapp}`,
      "email": profile.contact.email,
      "priceRange": "$$",
      "areaServed": [
        { "@type": "City", "name": "Yogyakarta" },
        { "@type": "City", "name": "Magelang" },
        { "@type": "Country", "name": "Indonesia" },
        { "@type": "Country", "name": "Worldwide" },
      ],
      "serviceType": [
        "Web Engineering & Architecture",
        "Landing Pages & Company Profiles",
        "Professional Portfolios",
        "Frontend Single Page Applications",
        "Figma to Code Slicing & Responsive UI",
      ],
      "provider": {
        "@id": "https://hanifabdillah.vercel.app/#person",
      },
    },
    {
      "@type": "WebSite",
      "@id": "https://hanifabdillah.vercel.app/#website",
      "url": "https://hanifabdillah.vercel.app/",
      "name": `${profile.name} — Portfolio & Web Services`,
      "description": siteDescription,
      "inLanguage": "en-US",
      "publisher": {
        "@id": "https://hanifabdillah.vercel.app/#person",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={siteDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={`${profile.name} Portfolio`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

    <script is:inline>
      // Apply theme before render to eliminate flash of unstyled content (FOUC).
      try {
        var t = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (t === "dark" || (!t && prefersDark)) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="bg-mesh" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
      <div class="blob blob-4"></div>
    </div>
    <slot />
  </body>
</html>
