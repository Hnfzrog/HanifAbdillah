---
import { experiences } from "../data/site";
---

<section class="section" id="experience">
  <div class="wrap">
    <div class="section-header">
      <p class="section-tag">Career History</p>
      <h2 class="section-title">Experience</h2>
      <p class="section-sub">My professional software engineering track record and production experience.</p>
    </div>
    <div class="timeline">
      {
        experiences.map((exp) => (
          <div class="glass timeline-item">
            <div class="item-head">
              <h3>{exp.role}</h3>
              <span class="period">{exp.period}</span>
            </div>
            <p class="org">{exp.org}</p>
            <p class="desc">{exp.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
