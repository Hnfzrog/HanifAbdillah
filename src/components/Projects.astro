---
import { projects } from "../data/site";
---

<section class="section" id="projects">
  <div class="wrap">
    <div class="section-header">
      <p class="section-tag">Portfolio & Code</p>
      <h2 class="section-title">Featured Projects</h2>
      <p class="section-sub">
        Real-world web applications and production systems developed with a focus on performance, scalability, and clean code architecture.
      </p>
    </div>

    <div class="projects-grid">
      {
        projects.map((p) => (
          <article class:list={["glass", "project-card", { "project-featured": p.featured }]}>
            <div class="project-header">
              <span class="project-category">{p.category}</span>
            </div>

            <h3 class="project-title">{p.title}</h3>
            <p class="project-desc">{p.description}</p>

            <ul class="project-highlights">
              {p.highlights.map((h) => (
                <li>
                  <svg class="w-4 h-4 highlight-check-icon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{h}</span>
                </li>
              ))}
            </ul>

            <div class="project-tags">
              {p.tags.map((tag) => (
                <span class="project-tag-pill">{tag}</span>
              ))}
            </div>

            <div class="project-actions">
              <a
                class="btn btn-sm btn-primary"
                href={p.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                </svg>
                <span>Repository</span>
              </a>
              {p.demoUrl && (
                <a
                  class="btn btn-sm btn-ghost"
                  href={p.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>Live Demo</span>
                  <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
