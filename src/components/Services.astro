---
import { services } from "../data/site";
---

<section class="section" id="services">
  <div class="wrap">
    <div class="section-header">
      <p class="section-tag">Solutions & Architecture</p>
      <h2 class="section-title">Services</h2>
      <p class="section-sub">
        End-to-end web engineering solutions with guaranteed clean code, responsive design, and production readiness.
      </p>
    </div>

    <div class="services-grid">
      {
        services.map((service) => (
          <div class="glass service-card">
            <div class="service-card-top">
              <span class="service-icon">
                {service.icon === "globe" && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                )}
                {service.icon === "user" && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                )}
                {service.icon === "terminal" && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <polyline points="4 17 10 11 4 5" />
                    <line x1="12" y1="19" x2="20" y2="19" />
                  </svg>
                )}
                {service.icon === "layout" && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <line x1="3" y1="9" x2="21" y2="9" />
                    <line x1="9" y1="21" x2="9" y2="9" />
                  </svg>
                )}
              </span>
              <h3>{service.title}</h3>
            </div>
            <p class="service-description">{service.description}</p>

            <div class="service-deliverables">
              <p class="deliverables-title">What You Get:</p>
              <ul>
                {service.deliverables.map((d) => (
                  <li>
                    <svg class="w-4 h-4 deliverable-check flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <div class="services-footer-cta">
      <div class="glass services-cta-box">
        <div>
          <h3>Have a Custom Project in Mind?</h3>
          <p>Discuss your specifications, timeline, or budget requirements. Free initial consultation.</p>
        </div>
        <a class="btn btn-primary" href="#contact">
          <span>Get in Touch</span>
          <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
